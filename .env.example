# App
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Alias used by some Auth.js versions
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Database (mysql2)
# Production: set DB_HOST to a reachable MySQL host (not 127.0.0.1).
# On Netlify, localhost / missing DB_HOST automatically enables mock data.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=AGA

# Optional Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase 2 — Google Maps (job/worker search map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map ID for custom markers (defaults to DEMO_MAP_ID for development)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional paid UK address autocomplete:
IDEAL_POSTCODES_API_KEY=
# Demo map data around Nottingham (skips DB for public job/worker search).
# When enabled, worker/employer profiles and jobs are also persisted to /.data/*.json
# and these logins work without MySQL:
#   full@aga.test / password123     (Advanced — full subscription)
#   worker@aga.test / password123   (Basic — worker subscription)
# Also auto-enabled on Netlify when DB_HOST is missing or 127.0.0.1/localhost.
USE_MOCK_MAP_DATA=1
# Force in-memory mock JSON (auto on Netlify). Data resets on cold starts.
# USE_MEMORY_MOCK_JSON=1
# Phase 3 — Stripe Billing (Checkout + Customer Portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_ADVANCED=

# Phase 4 — Capacitor (live deployment URL for the native WebView)
CAPACITOR_SERVER_URL=http://localhost:3000

# Phase 5 — email, push, object storage (MinIO on the VPS)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=admin@alwaysgrowingahead.com
SMTP_PASSWORD=
MAIL_FROM=Always Growing Ahead <admin@alwaysgrowingahead.com>
RESEND_API_KEY=
FIREBASE_SERVER_KEY=
R2_BUCKET_NAME=
S3_ENDPOINT=
# Browser-facing MinIO URL when S3_ENDPOINT is the Docker hostname (http://minio:9000).
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=aga-live
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1

