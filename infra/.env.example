# Copy to infra/.env and fill in before `docker compose up`.
# Never commit infra/.env.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=AGA
MYSQL_USER=aga
MYSQL_PASSWORD=change-me-aga

MYSQL_TEST_DATABASE=AGA_test
MYSQL_TEST_USER=aga_test
MYSQL_TEST_PASSWORD=change-me-aga-test

# ~25–50% of VPS RAM. 128M is safe on a 1–2 GB box; raise on larger plans.
MYSQL_INNODB_BUFFER_POOL=128M

# --- MinIO (S3-compatible file store) ---
MINIO_ROOT_USER=agaadmin
MINIO_ROOT_PASSWORD=change-me-minio-16chars
MINIO_LIVE_BUCKET=aga-live
MINIO_TEST_BUCKET=aga-test

# Public URL the Next.js app / browsers will use for uploads and downloads.
# Must match FILES_SITE_ADDRESS (including https:// once DNS + TLS are on).
MINIO_SERVER_URL=https://files.alwaysgrowingahead.com
S3_PUBLIC_URL=https://files.alwaysgrowingahead.com

# Copied into the Next.js image at build time (install.sh also reads /opt/aga/.env).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Caddy (app + file/S3 endpoints) ---
# :80 / :8080     → IP-only first boot (app on 80, MinIO on 8080)
# example.com / files.example.com → automatic HTTPS once DNS points at the VPS
APP_SITE_ADDRESS=alwaysgrowingahead.com
FILES_SITE_ADDRESS=files.alwaysgrowingahead.com
ACME_EMAIL=admin@alwaysgrowingahead.com
