# Copy to /opt/aga/.env (never commit). Used by the app container.
# Keep DB_* / S3_* in sync with infra/.env.

AUTH_SECRET=
AUTH_URL=https://alwaysgrowingahead.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://alwaysgrowingahead.com

DB_HOST=mysql
DB_PORT=3306
DB_USER=aga
DB_PASSWORD=
DB_NAME=AGA

USE_MOCK_MAP_DATA=0

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
IDEAL_POSTCODES_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_ADVANCED=

CAPACITOR_SERVER_URL=https://alwaysgrowingahead.com

SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=admin@alwaysgrowingahead.com
SMTP_PASSWORD=
MAIL_FROM=Always Growing Ahead <admin@alwaysgrowingahead.com>

RESEND_API_KEY=
FIREBASE_SERVER_KEY=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://files.alwaysgrowingahead.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=aga-live
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1
